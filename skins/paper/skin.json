{
  "format": "dnp-skin",
  "version": 1,
  "id": "paper",
  "name": "Paper",
  "about": "Modern and light-first: warm off-white paper, near-black ink, one terracotta accent, soft shadows instead of borders, generous radii, serif headings over a clean sans, drafting-paper canvases. Second mode: night, in warm darks.",
  "extends": "claude",

  "tokens": {
    "color": {
      "bg": {
        "app": "#f6f1e7", "rail": "#efe8da", "panel": "#fbf8f2", "raised": "#ffffff", "hover": "#f1ebdf",
        "input": "#ffffff", "overlay": "#fffdf9", "code": "#f7f2e8", "sunken": "#f3ede1"
      },
      "line": { "soft": "#ebe3d4", "main": "#ddd3c1", "strong": "#c3b7a2" },
      "text": { "primary": "#22201c", "secondary": "#5c564c", "dim": "#948b7c", "inverse": "#ffffff" },
      "accent": "#c2552d",
      "accentHover": "#ad4823",
      "accentInk": "#ffffff",
      "select": "#2a5db0",
      "playhead": "#2f8a62",
      "ok": "#3d8a5a",
      "warn": "#b7791f",
      "error": "#c0392b",
      "info": "#2a5db0",
      "guide": "#b83280",
      "wave": "#2f6f8f",
      "scrim": "rgba(40,32,20,.28)",
      "tone": { "when": "#b7791f", "if": "#2a5db0", "then": "#3d8a5a" },
      "node": { "event": "#f3d5cc", "condition": "#f2e3bf", "action": "#d3e0f2", "flow": "#e6e0d5", "data": "#d2e8d9", "camera": "#e5d6ef" },
      "marker": { "spawn": "#3d8a5a", "light": "#b7791f", "monster": "#c0392b", "prop": "#2a5db0" },
      "path": "#7a4fb0",
      "pathActive": "#9a6fd0",
      "checker": { "a": "#efe9dd", "b": "#e4dccd" },
      "keys": { "white": "#fffdf8", "black": "#2a2620" },
      "grid": { "minor": "rgba(42,93,176,.09)", "major": "rgba(42,93,176,.2)" },
      "ink": { "shadow": "rgba(60,40,10,.08)", "shadowSoft": "rgba(60,40,10,.05)", "shadowDeep": "rgba(60,40,10,.14)" }
    },
    "font": {
      "ui": "Inter, \"Helvetica Neue\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
      "serif": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif"
    },
    "size": { "tiny": 11, "small": 12, "body": 14, "large": 16, "title": 19, "hero": 30, "hit": 36, "hitSmall": 28, "icon": 18, "iconSmall": 15 },
    "weight": { "normal": 400, "strong": 550, "heavy": 650 },
    "radius": { "small": 6, "control": 10, "card": 14, "dialog": 18, "sheet": 22, "pill": 999 },
    "space": { "xs": 4, "sm": 8, "md": 12, "lg": 18, "xl": 28 },
    "shadow": {
      "raised": "0 1px 2px $color.ink.shadow, 0 1px 1px $color.ink.shadowSoft",
      "card": "0 1px 3px $color.ink.shadowSoft, 0 6px 18px $color.ink.shadowSoft",
      "menu": "0 14px 36px $color.ink.shadowDeep, 0 2px 6px $color.ink.shadowSoft",
      "sheet": "0 -6px 30px $color.ink.shadowDeep",
      "toast": "0 10px 30px $color.ink.shadowDeep"
    },
    "motion": { "fast": "160ms cubic-bezier(.2,.7,.3,1)" }
  },

  "modes": {
    "dark": null,
    "light": null,
    "day": {},
    "night": {
      "color": {
        "bg": {
          "app": "#1b1916", "rail": "#201d19", "panel": "#25221d", "raised": "#2e2a24", "hover": "#36312a",
          "input": "#211e1a", "overlay": "#2a2620", "code": "#1f1c18", "sunken": "#181613"
        },
        "line": { "soft": "#2e2a24", "main": "#3d372f", "strong": "#554d42" },
        "text": { "primary": "#f1ebe0", "secondary": "#c4baa9", "dim": "#8c8273", "inverse": "#1b1916" },
        "accent": "#e0784f",
        "accentHover": "#ea8a63",
        "accentInk": "#1b1916",
        "select": "#7fb0ee",
        "playhead": "#6cc196",
        "ok": "#6cc196",
        "warn": "#e3a94f",
        "error": "#ef7a6a",
        "info": "#7fb0ee",
        "guide": "#e27ab8",
        "wave": "#7ec4d8",
        "scrim": "rgba(0,0,0,.5)",
        "tone": { "when": "#e3a94f", "if": "#7fb0ee", "then": "#6cc196" },
        "node": { "event": "#5a2e26", "condition": "#57461f", "action": "#253c5c", "flow": "#3a352d", "data": "#244634", "camera": "#45305a" },
        "marker": { "spawn": "#6cc196", "light": "#e3a94f", "monster": "#ef7a6a", "prop": "#7fb0ee" },
        "path": "#b08ae0",
        "pathActive": "#cdb0f0",
        "checker": { "a": "#24211c", "b": "#2c2822" },
        "keys": { "white": "#efe9de", "black": "#1b1916" },
        "grid": { "minor": "rgba(127,176,238,.07)", "major": "rgba(127,176,238,.16)" },
        "ink": { "shadow": "rgba(0,0,0,.35)", "shadowSoft": "rgba(0,0,0,.25)", "shadowDeep": "rgba(0,0,0,.5)" }
      }
    }
  },

  "pointers": {
    "touch": { "size": { "body": 15, "hit": 46, "hitSmall": 38, "icon": 22, "iconSmall": 18 } }
  },

  "palettes": {
    "tracks": ["#2a5db0", "#c2552d", "#3d8a5a", "#7a4fb0", "#b7791f", "#2f8a8a", "#b83280", "#5c564c",
               "#4f7fd0", "#d9774f", "#5aa878", "#9a6fd0", "#d49a3a", "#4aa8a8", "#d05a9c", "#948b7c"],
    "layers": ["#2a5db0", "#c2552d", "#3d8a5a", "#7a4fb0"],
    "notes": { "slate": "#948b7c", "blue": "#2a5db0", "green": "#3d8a5a", "amber": "#d49a3a", "red": "#c0392b", "violet": "#7a4fb0" }
  },

  "icons": { "dir": "icons", "ext": "svg", "tint": true, "grid": 24, "stroke": 1.6 },

  "components": {
    "button": {
      "border": "1px solid $color.line.main", "shadow": "$shadow.raised", "padding": [0, 14],
      "hover": { "bg": "$color.bg.hover", "borderColor": "$color.line.strong" },
      "pressed": { "bg": "$color.line.soft", "shadow": "none" },
      "focus": { "outline": "2px solid $color.accent/55", "outlineOffset": 2 },
      "on": { "bg": "$color.accent/12", "borderColor": "$color.accent/45", "color": "$color.accent" },
      "variants": {
        "primary": { "shadow": "0 1px 2px $color.accent/30, 0 4px 12px $color.accent/18", "pressed": { "bg": "$color.accentHover", "shadow": "none" } },
        "ghost": { "shadow": "none", "hover": { "bg": "$color.bg.hover", "borderColor": "transparent" } },
        "danger": { "color": "$color.error", "hover": { "borderColor": "$color.error/50", "bg": "$color.error/6" } }
      }
    },
    "chip": {
      "bg": "$color.line.soft", "border": "1px solid transparent", "color": "$color.text.secondary", "weight": "$weight.strong",
      "hover": { "color": "$color.text.primary", "borderColor": "$color.line.main" },
      "on": { "bg": "$color.accent/12", "color": "$color.accent", "borderColor": "$color.accent/40" }
    },
    "seg": {
      "bg": "$color.line.soft", "border": "none", "padding": 3, "radius": "$radius.control",
      "item": { "radius": 8, "on": { "bg": "$color.bg.raised", "color": "$color.text.primary", "shadow": "$shadow.raised" } }
    },
    "switch": { "bg": "$color.line.strong", "on": { "bg": "$color.accent" }, "thumb": { "shadow": "0 1px 3px rgba(0,0,0,.25)" } },
    "mini": { "border": "1px solid $color.line.main", "bg": "$color.bg.raised", "radius": 6 },
    "help": { "border": "1px solid $color.line.main", "bg": "$color.bg.raised" },

    "field": {
      "border": "1px solid $color.line.main", "radius": "$radius.control",
      "hover": { "borderColor": "$color.line.strong" },
      "focus": { "borderColor": "$color.accent", "shadow": "0 0 0 4px $color.accent/15" },
      "error": { "borderColor": "$color.error", "shadow": "0 0 0 4px $color.error/12" },
      "variants": { "search": { "bg": "$color.line.soft", "border": "1px solid transparent" }, "code": { "bg": "$color.bg.code" } }
    },
    "stepper": { "border": "1px solid $color.line.main", "radius": "$radius.control", "focus": { "borderColor": "$color.accent" } },
    "slider": {
      "track": { "height": 4, "bg": "$color.line.main" },
      "fill": { "bg": "$color.accent" },
      "thumb": { "width": 18, "height": 18, "bg": "#ffffff", "border": "none", "shadow": "0 1px 3px rgba(0,0,0,.25), 0 0 0 1px $color.line.strong",
        "hover": { "shadow": "0 1px 3px rgba(0,0,0,.25), 0 0 0 6px $color.accent/15" } },
      "value": { "font": "$font.mono" }
    },
    "colorwell": { "radius": 8, "border": "1px solid $color.line.main", "selected": { "outline": "2px solid $color.accent", "outlineOffset": 2 } },
    "key": { "border": "1px solid $color.line.main", "shadow": "$shadow.raised", "waiting": { "bg": "$color.accent/12", "borderColor": "$color.accent", "color": "$color.accent" } },

    "card": {
      "border": "1px solid $color.line.soft", "shadow": "$shadow.card", "bg": "$color.bg.raised",
      "head": { "padding": [14, 16, 6, 16], "borderBottom": "none" },
      "title": { "font": "$font.serif", "size": "$size.large", "weight": 600 },
      "body": { "padding": [8, 16, 16, 16] },
      "variants": { "flat": { "shadow": "none", "border": "none", "bg": "transparent" } }
    },
    "section": {
      "radius": "$radius.control", "borderLeft": "3px solid $color.line.strong",
      "head": { "case": "none", "tracking": 0, "size": "$size.body", "font": "$font.serif", "italic": true, "weight": 600 }
    },
    "fold": {
      "border": "1px solid $color.line.soft", "shadow": "$shadow.card", "bg": "$color.bg.raised",
      "head": { "padding": [12, 14] },
      "title": { "font": "$font.serif", "weight": 600 },
      "open": { "head": { "borderBottom": "none" } }
    },
    "heading": {
      "font": "$font.serif", "size": "$size.title", "weight": 600, "case": "none", "tracking": 0, "color": "$color.text.primary",
      "padding": [22, 0, 8, 0], "icon": { "color": "$color.accent" }
    },
    "row": {
      "border": "1px solid transparent", "bg": "$color.bg.raised", "shadow": "$shadow.raised", "radius": 12,
      "hover": { "bg": "$color.bg.overlay", "borderColor": "$color.line.main" },
      "selected": { "borderColor": "$color.accent/45", "bg": "$color.accent/6", "shadow": "inset 3px 0 0 $color.accent" },
      "bad": { "borderColor": "$color.error/40", "bg": "$color.bg.raised", "color": "$color.error" },
      "thumb": { "radius": 8 },
      "mark": { "color": "$color.accent" }
    },
    "tile": {
      "border": "none", "shadow": "$shadow.card", "radius": "$radius.control", "bg": "$color.bg.raised",
      "selected": { "outline": "2px solid $color.accent", "outlineOffset": 2 },
      "caption": { "bg": "$color.bg.raised", "color": "$color.text.secondary", "padding": [5, 8] }
    },
    "strip": { "bg": "$color.line.soft", "radius": "$radius.control", "item": { "border": "none", "radius": 8, "selected": { "outline": "2px solid $color.accent" } } },

    "rail": {
      "bg": "$color.bg.rail", "borderRight": "1px solid $color.line.soft", "padding": 10, "gap": 3,
      "item": {
        "height": 40, "radius": 12, "color": "$color.text.secondary",
        "hover": { "bg": "$color.bg.hover", "color": "$color.text.primary" },
        "on": { "bg": "$color.bg.raised", "color": "$color.text.primary", "shadow": "$shadow.raised" }
      },
      "badge": {},
      "sep": { "bg": "$color.line.main" }
    },
    "topbar": {
      "height": 56, "padding": [0, 16], "bg": "$color.bg.app", "borderBottom": "1px solid $color.line.soft",
      "title": { "font": "$font.serif", "size": "$size.title", "weight": 600 }
    },
    "tabs": {
      "borderBottom": "1px solid $color.line.soft",
      "tab": { "color": "$color.text.dim", "on": { "color": "$color.text.primary", "borderBottom": "2px solid $color.accent" } }
    },
    "bottomtabs": { "bg": "$color.bg.overlay", "borderTop": "1px solid $color.line.soft", "tab": { "on": { "color": "$color.accent" } } },
    "toolbar": {
      "bg": "$color.bg.overlay", "border": "1px solid $color.line.soft", "shadow": "$shadow.menu", "radius": "$radius.dialog", "blur": 0, "padding": 6,
      "tool": { "radius": 12, "hover": { "bg": "$color.bg.hover", "color": "$color.text.primary" }, "on": { "bg": "$color.accent", "color": "$color.accentInk" } }
    },
    "sheet": {
      "bg": "$color.bg.overlay", "border": "1px solid $color.line.soft",
      "head": { "padding": [14, 16], "borderBottom": "none" },
      "title": { "font": "$font.serif", "size": "$size.large", "weight": 600 },
      "body": { "padding": [4, 16, 16, 16], "gap": 12 },
      "variants": { "side": { "borderLeft": "1px solid $color.line.soft", "shadow": "-8px 0 30px $color.ink.shadowSoft" } }
    },
    "drawer": { "bg": "$color.bg.overlay", "border": "1px solid $color.line.soft", "head": { "borderBottom": "none", "font": "$font.serif" } },

    "dialog": {
      "border": "1px solid $color.line.soft", "padding": 6,
      "head": { "padding": [16, 18, 4, 18] },
      "title": { "font": "$font.serif", "size": "$size.title", "weight": 600 },
      "body": { "padding": [6, 18, 14, 18] },
      "foot": { "padding": [8, 18, 16, 18] }
    },
    "menu": {
      "border": "1px solid $color.line.soft", "padding": 6, "radius": 14,
      "item": { "radius": 8, "height": 34, "hover": { "bg": "$color.bg.hover", "color": "$color.text.primary" } },
      "group": { "case": "none", "tracking": 0, "font": "$font.serif", "italic": true, "size": "$size.small", "weight": 500 }
    },
    "toast": {
      "bg": "$color.text.primary", "color": "$color.text.inverse", "border": "none", "radius": "$radius.pill", "padding": [10, 18],
      "close": { "color": "$color.text.inverse", "hover": { "color": "$color.accent" } },
      "variants": { "ok": { "borderLeft": "none" }, "warn": { "borderLeft": "none" }, "error": { "borderLeft": "none" } }
    },

    "pill": { "bg": "$color.line.soft", "border": "1px solid transparent" },
    "callout": {
      "border": "1px solid transparent", "radius": 12,
      "variants": { "error": { "borderColor": "transparent" }, "warn": { "borderColor": "transparent" }, "info": { "borderColor": "transparent" } }
    },
    "progress": { "track": { "bg": "$color.line.soft", "height": 6 } },
    "boot": {
      "title": { "font": "$font.serif", "size": "$size.hero", "weight": 600, "italic": true },
      "track": { "bg": "$color.line.soft", "height": 4 },
      "status": { "font": "$font.ui", "color": "$color.text.secondary" },
      "log": { "bg": "$color.bg.raised", "border": "1px solid $color.line.soft", "shadow": "$shadow.card", "radius": 12 }
    },
    "log": { "border": "1px solid $color.line.soft", "radius": 12 },
    "empty": { "border": "1.5px dashed $color.line.strong", "radius": 14, "text": { "font": "$font.serif", "italic": true, "size": "$size.large" } },
    "kbd": { "border": "1px solid $color.line.main", "borderBottom": "2px solid $color.line.strong", "radius": 5 },

    "transport": {
      "bg": "$color.bg.raised", "border": "1px solid $color.line.soft", "shadow": "$shadow.raised", "radius": 14,
      "button": { "radius": 10, "on": { "bg": "$color.accent", "color": "$color.accentInk" } },
      "display": { "color": "$color.text.primary", "bg": "$color.line.soft", "radius": 8 }
    },
    "meter": { "bg": "$color.line.soft", "border": "none", "radius": 999 },
    "keys": { "radius": 10, "white": { "border": "1px solid $color.line.strong" } },
    "pad": { "border": "1px solid $color.line.main", "shadow": "$shadow.raised", "radius": 12, "on": { "bg": "$color.accent" } }
  },

  "canvas": {
    "common": {
      "grid.minor": "$color.grid.minor",
      "grid.major": "$color.grid.major",
      "marquee": { "color": "$color.text.primary", "dash": [4, 3] },
      "marquee.shadow": { "color": "$color.bg.raised", "dash": [4, 3] },
      "handle": { "fill": "$color.bg.raised", "color": "$color.text.primary", "size": 8 },
      "handle.hot": { "fill": "$color.accent", "color": "$color.bg.raised", "size": 9 },
      "handle.idle": { "fill": "$color.bg.raised", "color": "$color.text.dim", "size": 7 },
      "label": { "fill": "$color.bg.raised/95", "color": "$color.text.primary", "font": "500 11px $font.ui" },
      "guide": { "color": "$color.guide", "dash": [4, 4] },
      "text": { "color": "$color.text.secondary", "font": "italic 12px $font.serif" }
    },
    "map": {
      "room.fill": "$color.bg.raised/85",
      "room.line": "$color.text.secondary",
      "marker": { "fill": "$color.bg.raised", "color": "$color.text.primary", "width": 1.5, "radius": 9, "font": "500 11px $font.ui" }
    },
    "graph": {
      "dot": { "fill": "$color.line.strong", "size": 24 },
      "node": { "fill": "$color.bg.raised", "color": "$color.line.main", "radius": 12 },
      "node.title": { "color": "$color.text.primary", "font": "600 12px $font.ui" },
      "node.selected": { "color": "$color.accent", "width": 2 },
      "wire.selected": { "color": "$color.accent", "width": 3.5 },
      "bend.selected": { "fill": "$color.accent", "size": 6 },
      "state.selected": { "color": "$color.accent", "width": 2 },
      "state.initial": "$color.accent",
      "edge.label": { "color": "$color.text.secondary", "fill": "$color.bg.sunken", "font": "italic 12px $font.serif" }
    },
    "rig": {
      "viewLabel": { "fill": "$color.bg.raised/92", "color": "$color.text.primary", "font": "600 13px $font.serif" }
    }
  }
}
